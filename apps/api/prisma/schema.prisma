// Samjho database schema.
//
// Phase 0 deliberately defines no models. The full domain model — questions as
// a tree, exam slots with internal choice, attempts, mastery rollups — lands in
// Phase 1, designed in docs/03-data-model.md.
//
// What exists here is the plumbing: a generated client and a verified
// connection, which is what /ready needs to be meaningful.
//
// Note there is no `url` here. Prisma 7 removed connection URLs from the schema:
// the CLI reads it from prisma.config.ts, and the runtime client gets it through
// a driver adapter (see src/lib/prisma.ts). One less place for a credential to
// end up somewhere it shouldn't.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
