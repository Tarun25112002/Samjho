# apps/api environment.
#
#   cp .env.example .env
#
# Every variable is validated at boot by src/lib/config.ts. A missing or
# malformed value stops the process immediately with a precise message, rather
# than surfacing as `undefined` on some random code path later.
#
# Env files are per-app, not repo-root. Next.js only reads `.env` from its own
# directory, and having the API behave the same way keeps one rule instead of
# two — plus it keeps the AI provider key (Phase 7) physically out of the web
# app's directory.

NODE_ENV="development"
PORT=4000
LOG_LEVEL="debug"

# Matches docker-compose.yml. Start it with `pnpm db:up` from the repo root.
DATABASE_URL="postgresql://samjho:samjho@localhost:5432/samjho?schema=public"

# Behind a connection pooler (PgBouncer/Neon), migrations must bypass the pooler:
# DIRECT_URL="postgresql://samjho:samjho@localhost:5432/samjho?schema=public"

# Comma-separated origins allowed to call this API.
WEB_ORIGIN="http://localhost:3000"

# ─── Clerk ───────────────────────────────────────────────────────────────────
# All four are required — the API refuses to boot without them. An API that
# starts without the ability to verify a token is an API that will eventually
# answer a request it should have refused.

# Your instance's Frontend API origin. This is the `iss` claim on every session
# token and the base for the JWKS endpoint. Clerk dashboard → API keys → Show
# JWT public key → Issuer. No trailing slash.
CLERK_ISSUER_URL="https://your-instance.clerk.accounts.dev"

# Server-side key (sk_test_… / sk_live_…). Used for exactly one thing here:
# looking up a user's email when we meet a Clerk id with no local row yet.
CLERK_SECRET_KEY=""

# Clerk dashboard → Webhooks → your endpoint → Signing Secret (whsec_…).
# Without this, /webhooks/clerk is an unauthenticated endpoint that writes to
# the users table.
CLERK_WEBHOOK_SIGNING_SECRET=""

# Origins permitted to have obtained a token (the `azp` claim). Defaults to
# WEB_ORIGIN; set it only when the browser's origin and the API's idea of it
# legitimately differ.
# CLERK_AUTHORIZED_PARTIES="http://localhost:3000"

# Override the JWKS location. Derived from CLERK_ISSUER_URL when unset.
# CLERK_JWKS_URL=""

# ─── AI providers ────────────────────────────────────────────────────────────
# Server-side only, and only ever here. These keys must never appear in apps/web
# and must never gain a NEXT_PUBLIC_ prefix — those values are inlined into the
# browser bundle, so putting a key there publishes it.
#
# None of them is required. With no key set the API still boots and still serves
# every endpoint; the features that need a model decline and say so. Teachers
# see "reading papers is not switched on here" on the upload screen rather than
# a button that fails, and the AI tutor degrades to the stored solution.
#
# The chain is tried in order, and each entry is used only if the one before it
# failed *before producing any output*. A provider with no key is dropped at
# startup with a warning rather than failing the boot.
# AI_PROVIDER_CHAIN="openrouter,gemini,grok"

# OpenRouter — one key, many upstream models, its own failover between providers
# of the same model. First in the chain because it is the broadest single point
# of access, and it reads PDFs, which paper extraction needs.
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL_STRONG="google/gemini-2.5-pro"
# OPENROUTER_MODEL_FAST="google/gemini-2.5-flash"

# Google Gemini, direct — deliberately not through OpenRouter. A chain whose
# every hop runs through one vendor's gateway fails as a unit the moment that
# gateway does, which is the failure a chain exists to survive. It also has the
# best document handling of the three, which is what a scanned paper needs.
# GEMINI_API_KEY=""

# xAI Grok. Reads images but has no document input, so it is skipped for a PDF
# upload rather than being sent one it cannot see.
# XAI_API_KEY=""

# --- Tutor budgets and deadlines ---------------------------------------------
#
# The two timeouts are separate because they guard different things. The
# first-token deadline is the one that governs failover: a provider that has not
# started answering within it is moved past, since it will not save the request
# by finishing later. The request timeout only starts mattering once text is
# already flowing, where a long answer is not a stalled one.
# AI_REQUEST_TIMEOUT_MS="45000"
# AI_FIRST_TOKEN_TIMEOUT_MS="12000"

# How long a failed provider is demoted for. Doubles per consecutive failure, to
# a cap, so a hard-down primary stops costing every request its timeout.
# AI_PROVIDER_COOLDOWN_MS="60000"

# Per-student, per-UTC-day. Exhausting these is not an error: the tutor serves
# the stored human-written solution and says that is what it is doing.
# AI_DAILY_MESSAGE_QUOTA="30"
# AI_DAILY_TOKEN_QUOTA="120000"

# Burst control, which *is* an error — ten messages in five minutes is a stuck
# client, not a student revising hard.
# AI_RATE_LIMIT_MESSAGES="10"
# AI_RATE_LIMIT_WINDOW_MS="300000"

# Sent to OpenRouter as attribution headers; shows up on their dashboard.
# AI_SITE_URL="https://samjho.app"
# AI_SITE_NAME="Samjho"
