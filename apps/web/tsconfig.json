{
  "extends": "@samjho/config/tsconfig/next.json",
  "compilerOptions": {
    // No `baseUrl`: since TS 4.4 `paths` resolve relative to this file's
    // directory, which is what we want, and `baseUrl` is on its way out.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
