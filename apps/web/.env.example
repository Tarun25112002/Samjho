# apps/web environment.
#
#   cp .env.example .env
#
# Validated at module load by src/lib/env.ts.
#
# The NEXT_PUBLIC_ prefix is a security boundary, not a naming convention:
# prefixed values are inlined into the JavaScript bundle at build time and are
# therefore world-readable. No secret ever gets that prefix. The web app holds
# no secrets at all in Phase 0 — both values below are just addresses.

# Server-to-server base URL, used by Server Components. Differs from the public
# URL when the API is reachable on a private network (Docker, internal DNS).
API_URL="http://localhost:4000"

# Browser-visible base URL. Public by design.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Clerk ───────────────────────────────────────────────────────────────────
# Both keys come from the same Clerk instance as apps/api's. The naming is the
# whole security story: `pk_` is meant to reach the browser and carries no
# authority, `sk_` must never leave the server. Note that CLERK_SECRET_KEY here
# has no NEXT_PUBLIC_ prefix and never will.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk sends people. These are read by `proxy.ts` as well as the client,
# and middleware can *only* learn them from the environment — so unlike most
# config they cannot move into code. Without them, Clerk falls back to its own
# hosted pages, which works but leaves the product.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/home"
# New accounts go to onboarding, not the dashboard — the app shell would bounce
# them here anyway, and skipping the extra hop is a nicer first impression.
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/welcome"
