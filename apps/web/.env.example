# apps/web environment.
#
#   cp .env.example .env
#
# Validated at module load by src/lib/env.ts.
#
# The NEXT_PUBLIC_ prefix is a security boundary, not a naming convention:
# prefixed values are inlined into the JavaScript bundle at build time and are
# therefore world-readable. No secret ever gets that prefix. The web app holds
# no secrets at all in Phase 0 — both values below are just addresses.

# Server-to-server base URL, used by Server Components. Differs from the public
# URL when the API is reachable on a private network (Docker, internal DNS).
API_URL="http://localhost:4000"

# Browser-visible base URL. Public by design.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Phase 2: Clerk ──────────────────────────────────────────────────────────
# Publishable keys are designed to be public; the secret key stays in apps/api.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
