# Normalise line endings to LF in the repository.
#
# Without this, Git on Windows checks files out as CRLF while Prettier is
# configured with `endOfLine: "lf"`. CI runs `format:check` on Linux, so the
# mismatch shows up as a formatting failure that is impossible to reproduce
# locally on Windows — and vice versa.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated: collapse in diffs and exclude from language statistics.
pnpm-lock.yaml linguist-generated=true -diff
