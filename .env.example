# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env
#
# Every variable here is validated at boot: apps/api/src/lib/config.ts and
# apps/web/src/lib/env.ts. A missing or malformed value fails the process
# immediately with a precise message rather than at some random code path later.

# ─── Database ────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. `pnpm db:up` starts it.
DATABASE_URL="postgresql://samjho:samjho@localhost:5432/samjho?schema=public"

# When the database sits behind a connection pooler (PgBouncer, Neon), point
# this at the direct connection — migrations must bypass the pooler.
# DIRECT_URL="postgresql://samjho:samjho@localhost:5432/samjho?schema=public"

# ─── API (apps/api) ──────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
LOG_LEVEL="debug"
# Comma-separated list of origins allowed to call the API.
WEB_ORIGIN="http://localhost:3000"

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
# Server-to-server. Differs from the public URL inside Docker or on a private network.
API_URL="http://localhost:4000"
# Browser-visible. Public by design — it is an address, not a secret.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── Phase 2: Clerk ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
# CLERK_WEBHOOK_SECRET=""

# ─── Phase 7: AI ─────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. This key must never gain a NEXT_PUBLIC_ prefix and must
# never be read from apps/web — NEXT_PUBLIC_ values are inlined into the browser
# bundle, so putting a key there publishes it.
# AI_PROVIDER="anthropic"
# ANTHROPIC_API_KEY=""
